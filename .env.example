# Sentinel-X production (docker compose). Everything is OPTIONAL:
# `docker compose up -d --build` works without this file. Secrets, keys and
# certificates are generated automatically; never put them here.
# Copy to .env only to change a value below.

# Names and addresses used to reach the dashboard (comma-separated). They are
# added to the HTTPS certificate and to the allowed origins. Example for the
# table network: PUBLIC_HOSTS=192.168.10.1,sentinel-x.local
PUBLIC_HOSTS=localhost

# Published ports (HTTP only redirects to HTTPS).
HTTP_PORT=80
HTTPS_PORT=443

# First administrator, created on the first start with a generated password:
#   docker compose exec backend cat /run/sentinel/secrets/initial-admin-password
ADMIN_EMAIL=admin@sentinel-x.local

# Sensor history and AI predictions retention (days).
READINGS_RETENTION_DAYS=7

# Webcam of the server (0 = first camera) and automatic start.
VISION_CAMERA_INDEX=0
VISION_AUTO_START=false

# Optional e-mail notifications. STARTTLS is required on 587; SMTP_SECURE=true for 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SENTINEL-X <sentinel-x@localhost>

# Broker port on 127.0.0.1 for a USB bridge running on the host (Windows/macOS).
MQTT_TLS_PORT=8883
