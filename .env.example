# Docker Compose configuration. Copy to .env and fill the private secret.
# For native Windows services, use iot-backend/.env.example and ai/.env.example.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Required: generate a private random value of at least 32 characters.
BETTER_AUTH_SECRET=

MQTT_URL=mqtt://host.docker.internal:1883
MQTT_VISION_TOPIC=sentinel/vision
READINGS_RETENTION_DAYS=7

# Optional: local Python service running on the host. Empty disables AI.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=5000
AI_POLL_MS=2000
# Set explicitly when relaying a camera stream through Docker.
VISION_STREAM_URL=

# Optional mail transport. No messages are sent without SMTP_HOST.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SENTINEL-X <sentinel-x@localhost>
