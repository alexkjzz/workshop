# Node reads environment variables. For this file use:
# node --env-file=.env --import tsx src/main.ts
PORT=3001
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TELEMETRY_TOPIC=esp8266/donnees
MQTT_COMMAND_TOPIC=esp8266/led
MQTT_VISION_TOPIC=sentinel/vision
TELEMETRY_DATABASE_PATH=data/telemetry.db
READINGS_RETENTION_DAYS=7
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=5000
AI_POLL_MS=2000
AI_SERVICE_TOKEN=
# Omit VISION_STREAM_URL to relay AI_SERVICE_URL/stream.mjpg.
# Set it explicitly for an existing camera service, or empty to disable video.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_URL=http://localhost:5173
# Generate a private secret (at least 32 characters) before starting.
BETTER_AUTH_SECRET=
AUTH_DATABASE_PATH=data/auth.db
SETTINGS_DATABASE_PATH=data/settings.db
TRUST_PROXY=loopback
