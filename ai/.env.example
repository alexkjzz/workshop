# Python is local to the backend machine; never point the browser at Python.
AI_HOST=127.0.0.1
AI_PORT=8001
# Optional shared token: use the same AI_SERVICE_TOKEN in the backend.
AI_SERVICE_TOKEN=
BACKEND_URL=http://127.0.0.1:3001
ANOMALY_MODEL=models/isolation_forest.joblib
SENSOR_CSV=data/sensor_data.csv
ANOMALY_WINDOW=12
ANOMALY_CONTAMINATION=0.03
SENSOR_STALE_SECONDS=30
VISION_STALE_SECONDS=5
# 0 prefers the USB webcam; -1 scans available indices. CAMERA_INDEX remains supported.
VISION_CAMERA_INDEX=0
CAMERA_SCAN_LIMIT=4
YOLO_MODEL=models/yolov8n.pt
YOLO_CONFIDENCE=0.55
VISION_CONFIRM_FRAMES=3
VISION_FRAME_STRIDE=3
VISION_MAX_FPS=15
VISION_TRACKING=true
VISION_AUTO_START=false
FACE_RECOGNITION_ENABLED=true
FACE_RECOGNITION_THRESHOLD=0.55
FACE_RECOGNITION_EVERY_N_FRAMES=3
FACE_RECOGNITION_MAX_FPS=2
FACE_KNOWN_DIR=known_faces
FACE_EVENT_COOLDOWN_SECONDS=5
FACE_MIN_SIZE_PIXELS=40
FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_EMBEDDING_MODEL=models/face_recognition_sface_2021dec.onnx
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TELEMETRY_TOPIC=esp8266/donnees
